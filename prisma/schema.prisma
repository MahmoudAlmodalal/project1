datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum LoanStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  CHECKED_OUT
  RETURNED
  OVERDUE
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
  TOTAL_LOSS
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(255)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  fullName        String      @map("full_name") @db.VarChar(255)
  studentId       String?     @unique @map("student_id") @db.VarChar(64)
  department      String      @db.VarChar(128)
  phone           String      @db.VarChar(32)
  role            Role        @default(STUDENT)
  status          UserStatus  @default(PENDING_APPROVAL)
  rejectionReason String?     @map("rejection_reason") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  loansRequested   Loan[]         @relation("StudentLoans")
  loansApproved    Loan[]         @relation("ApprovedLoans")
  loansCheckedOut  Loan[]         @relation("CheckedOutLoans")
  loansReturned    Loan[]         @relation("ReturnedLoans")
  damageReports    DamageRecord[] @relation("ReportedDamages")

  @@map("users")
  @@index([status])
  @@index([role])
}

model Category {
  id        String      @id @default(uuid()) @db.Uuid
  nameAr    String      @unique @map("name_ar") @db.VarChar(128)
  nameEn    String      @unique @map("name_en") @db.VarChar(128)
  slug      String      @unique @db.VarChar(128)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  equipment Equipment[]

  @@map("categories")
}

model Equipment {
  id                String         @id @default(uuid()) @db.Uuid
  categoryId        String         @map("category_id") @db.Uuid
  nameAr            String         @map("name_ar") @db.VarChar(255)
  nameEn            String         @map("name_en") @db.VarChar(255)
  descriptionAr     String         @map("description_ar") @db.Text
  descriptionEn     String         @map("description_en") @db.Text
  imageUrl          String         @map("image_url") @db.VarChar(512)
  totalQuantity     Int            @default(0) @map("total_quantity")
  availableQuantity Int            @default(0) @map("available_quantity")
  reservedQuantity  Int            @default(0) @map("reserved_quantity")
  borrowedQuantity  Int            @default(0) @map("borrowed_quantity")
  damagedQuantity   Int            @default(0) @map("damaged_quantity")
  isArchived        Boolean        @default(false) @map("is_archived")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  loans             Loan[]
  damageRecords     DamageRecord[]

  @@map("equipment")
  @@index([categoryId])
  @@index([isArchived])
}

model Loan {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  equipmentId          String         @map("equipment_id") @db.Uuid
  durationDays         Int            @map("duration_days")
  academicJustification String         @map("academic_justification") @db.Text
  status               LoanStatus     @default(PENDING_REVIEW)
  requestedAt          DateTime       @default(now()) @map("requested_at") @db.Timestamptz()
  approvedAt           DateTime?      @map("approved_at") @db.Timestamptz()
  approvedById         String?        @map("approved_by") @db.Uuid
  pickupDeadline       DateTime?      @map("pickup_deadline") @db.Timestamptz()
  checkedOutAt         DateTime?      @map("checked_out_at") @db.Timestamptz()
  checkedOutById       String?        @map("checked_out_by") @db.Uuid
  expectedReturnDate   DateTime?      @map("expected_return_date") @db.Timestamptz()
  returnedAt           DateTime?      @map("returned_at") @db.Timestamptz()
  returnedById         String?        @map("returned_by") @db.Uuid
  rejectionReason      String?        @map("rejection_reason") @db.Text
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user                 User           @relation("StudentLoans", fields: [userId], references: [id], onDelete: Restrict)
  equipment            Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  approvedBy           User?          @relation("ApprovedLoans", fields: [approvedById], references: [id], onDelete: SetNull)
  checkedOutBy         User?          @relation("CheckedOutLoans", fields: [checkedOutById], references: [id], onDelete: SetNull)
  returnedBy           User?          @relation("ReturnedLoans", fields: [returnedById], references: [id], onDelete: SetNull)
  damageRecords        DamageRecord[]

  @@map("loans")
  @@index([userId, status])
  @@index([equipmentId])
  @@index([status])
  @@index([pickupDeadline])
  @@index([expectedReturnDate])
}

model DamageRecord {
  id          String         @id @default(uuid()) @db.Uuid
  loanId      String         @map("loan_id") @db.Uuid
  equipmentId String         @map("equipment_id") @db.Uuid
  reportedById String        @map("reported_by") @db.Uuid
  severity    DamageSeverity
  notes       String         @db.Text
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  loan        Loan           @relation(fields: [loanId], references: [id], onDelete: Restrict)
  equipment   Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reportedBy  User           @relation("ReportedDamages", fields: [reportedById], references: [id], onDelete: Restrict)

  @@map("damage_records")
  @@index([equipmentId])
  @@index([loanId])
}
